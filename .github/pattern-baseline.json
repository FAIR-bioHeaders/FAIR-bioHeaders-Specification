  "countingScope": {
    "keyword": "the `pattern` keyword only; `patternProperties` keys are regular expressions too and are out of this scope by design (#270 follow-up), so this is narrower than the regex-entry census in the #271 docs page",
    "unit": "entry = one (file, JSON pointer) pair; the same string under two pointers counts twice; entriesEndingInDollar counts entries whose text ends in `$`; distinctPatternStrings counts unique strings",
    "governedFiles": "discovered by rule, not enumerated; see discoveryRule"
  },
