{
  "@context": {
    "fhr": "https://w3id.org/fair-bioheaders/terms#",
    "sdo": "http://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "https://w3id.org/fair-bioheaders/terms",
      "@type": "owl:Ontology",
      "rdfs:label": {
        "@value": "FAIR-bioHeaders vocabulary",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Terms for FAIR-bioHeaders metadata that have no schema.org equivalent. Generated from the FHR-Specification LinkML model; do not edit.",
        "@language": "en"
      },
      "dcterms:license": {
        "@id": "https://www.mozilla.org/en-US/MPL/2.0/"
      },
      "rdfs:seeAlso": {
        "@id": "https://github.com/FAIR-bioHeaders/FHR-Specification/blob/main/docs/TERMS.md"
      }
    },
    {
      "@id": "fhr:Agent",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "Agent",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "A person or organization that the FHR record does not classify; FHR records the kind of agent through nameType or an ORCID or ROR identifier.",
        "@language": "en"
      },
      "rdfs:subClassOf": [
        {
          "@id": "sdo:Thing"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "dcterms:Agent"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:VitalStats",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "VitalStats",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "General statistics about the genome assembly. N50, N90, L50 and L90 are contig statistics; the scaffold* variants are the scaffold statistics.",
        "@language": "en"
      },
      "rdfs:subClassOf": [
        {
          "@id": "sdo:StructuredValue"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:accessionID",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "accessionID",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Genome assembly accession",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:PropertyValue"
        }
      ],
      "rdfs:subPropertyOf": [
        {
          "@id": "sdo:identifier"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:assemblyProtocol",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "assemblyProtocol",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Assembly protocol or workflow reference URI.",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:URL"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:assemblySoftware",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "assemblySoftware",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Assembly software provenance or a legacy name.",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        },
        {
          "@id": "sdo:SoftwareApplication"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:checksum",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "checksum",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "sha2-512/256 checksum value for hashing",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:commandLineOption",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "commandLineOption",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Command-line options given to the assembly software, in order",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:SoftwareApplication"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:gcContent",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "gcContent",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "GC content as a percentage from 0 to 100, not a fraction (write 42.0 for 42 percent; 0.42 means 0.42 percent)",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:VitalStats"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Number"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:instrument",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "instrument",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Physical tools and instruments used in the creation of the genome assembly",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:L50",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "L50",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Contig L50, the smallest number of contigs whose lengths sum to at least 50 percent of the assembly length",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:VitalStats"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Integer"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:L90",
