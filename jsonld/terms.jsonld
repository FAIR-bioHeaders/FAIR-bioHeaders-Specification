{
  "@context": {
    "fhr": "https://w3id.org/fair-bioheaders/terms#",
    "sdo": "http://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "https://w3id.org/fair-bioheaders/terms",
      "@type": "owl:Ontology",
      "rdfs:label": {
        "@value": "FAIR-bioHeaders vocabulary",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Terms for FAIR-bioHeaders metadata that have no schema.org equivalent. Generated from the FAIR-bioHeaders-Specification LinkML model; do not edit.",
        "@language": "en"
      },
      "dcterms:license": {
        "@id": "https://www.mozilla.org/en-US/MPL/2.0/"
      },
      "rdfs:seeAlso": {
        "@id": "https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Specification/blob/main/docs/TERMS.md"
      }
    },
    {
      "@id": "fhr:Agent",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "Agent",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "A person or organization that the FHR record does not classify; FHR records the kind of agent through nameType or an ORCID or ROR identifier.",
        "@language": "en"
      },
      "rdfs:subClassOf": [
        {
          "@id": "sdo:Thing"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "dcterms:Agent"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:AssemblyAuthor",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "AssemblyAuthor",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "An assembly author with a supplied non-blank name (Q4 follow-up). The assemblyAuthor list stays optional; when present, every item names its person or organization.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:Completeness",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "Completeness",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "BUSCO completeness as counts, with the lineage dataset whose name gives its version (for example primates_odb10 or enterobacterales_odb12.2)",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:DerivedFrom",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "DerivedFrom",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Link to a parent file by its FHR-family checksum (specs/004-shared-core-schema FR-003). Provisional until the relationship vocabulary is decided (FAIR-bioHeaders-Specification#54).",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:MetadataAuthor",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "MetadataAuthor",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "A metadata author with a supplied non-blank name, under the approved Q4 follow-up. Optional assemblyAuthor items follow the same rule (AssemblyAuthor).",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:Sample",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "Sample",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "One supplied biological sample context. Pooled material is represented by repeated items, not by one fabricated uniform value.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:VitalStats",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "VitalStats",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "General statistics about the genome assembly, computed as FORMAT.md R16 defines. N50, N90, L50 and L90 are contig statistics; the scaffold* variants are the scaffold statistics.",
        "@language": "en"
      },
      "rdfs:subClassOf": [
        {
          "@id": "sdo:StructuredValue"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:accessionID",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "accessionID",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Genome assembly accession",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        },
        {
          "@id": "fhr:DerivedFrom"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:PropertyValue"
        }
      ],
      "rdfs:subPropertyOf": [
        {
          "@id": "sdo:identifier"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:assemblyAuthor",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "assemblyAuthor",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Attributions for the assembly or extraction, when supplied",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "fhr:AssemblyAuthor"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:assemblyProtocol",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "assemblyProtocol",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Assembly protocol or workflow reference URI.",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:URL"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:assemblySoftware",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "assemblySoftware",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Assembly software provenance or a legacy name.",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        },
        {
          "@id": "sdo:SoftwareApplication"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:assemblyType",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "assemblyType",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Construction case for the whole described transcript set",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:averageTranscriptLength",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "averageTranscriptLength",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Mean number of sequence symbols per record, excluding deflines and line endings",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:VitalStats"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Number"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:buscoVersion",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "buscoVersion",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Version of BUSCO",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:Completeness"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:checksum",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "checksum",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "sha2-512/256 checksum value for hashing",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        },
        {
          "@id": "fhr:DerivedFrom"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:commandLineOption",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "commandLineOption",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Command-line options given to the assembly software, in order",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:SoftwareApplication"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:completeDuplicated",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "completeDuplicated",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Complete duplicated BUSCOs (D)",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:Completeness"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Integer"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:completeness",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "completeness",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Optional BUSCO completeness counts from the actual run. lineageDataset must match the pinned shared pattern (a name ending in _odb plus one or more dot-separated numeric version components, such as hymenoptera_odb10 or hymenoptera_odb12.2), as widened by shared #170 for v0.6.0. Do not rename or coerce a measured lineage to fit the pattern; if a measured value cannot be represented, omit completeness and keep the lineage and counts in documentation. When completeSingle, completeDuplicated, fragmented, missing and total are all supplied as integers, the four mutually exclusive component counts must sum exactly to total (C1). This cross-field arithmetic is checked by the owning reader, not expressible in standard JSON Schema.",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "fhr:Completeness"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:completeSingle",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "completeSingle",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Complete single-copy BUSCOs (S)",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:Completeness"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Integer"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:condition",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "condition",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Supplied treatment, disease or other condition context",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:Sample"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:derivedFrom",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "derivedFrom",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Reviewed FAIR-bioHeaders parent-file relationships only. This contract permits an FHT filteredFrom parent or an FHR transcribedFrom parent when the transcript bases were extracted from that genome; genome guidance alone never justifies transcribedFrom. Annotation coordinates and other sources stay in relatedLink/documentation until the shared relationship vocabulary is decided (#54). A genome-guided set whose final sequences were actually extracted from that genome also uses FHR transcribedFrom; construction history alone does not establish the source of its bases. The shared DerivedFrom object requires the parent's FHR-family checksum; an accession alone is not a verified family link. Identical parent entries are not allowed. A parent checksum uses canonical padded base64 for the 32-byte SHA-512/256 digest.",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "fhr:DerivedFrom"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:developmentalStage",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "developmentalStage",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Supplied developmental stage or life stage",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:Sample"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:fragmented",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "fragmented",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Fragmented BUSCOs (F)",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:Completeness"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Integer"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:gcContent",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "gcContent",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "GC content as a percentage from 0 to 100, not a fraction (write 42.0 for 42 percent; 0.42 means 0.42 percent); N and other ambiguity letters are excluded from numerator and denominator (see FORMAT.md R16)",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:VitalStats"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Number"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:headerType",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "headerType",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "FAIR-bioHeaders type of the parent file",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:DerivedFrom"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:instrument",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "instrument",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Physical tools and instruments used in the creation of the genome assembly",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:L50",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "L50",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Contig L50, the smallest number of contigs, longest first, whose lengths sum to at least 50 percent of the summed contig length (see FORMAT.md R16)",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:VitalStats"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Integer"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:L90",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "L90",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Contig L90, the smallest number of contigs, longest first, whose lengths sum to at least 90 percent of the summed contig length (see FORMAT.md R16)",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:VitalStats"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Integer"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:libraryStrategy",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "libraryStrategy",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "One supplied library strategy term for the whole set, using the producer's ENA term where applicable. Omit when experiments differ or the value is unknown; this slot is not an ENA-controlled enum.",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:lineageDataset",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "lineageDataset",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "BUSCO lineage dataset, including its version suffix; one or more dot-separated numeric version components are allowed, as BUSCO datasets are re-released (for example odb12.2)",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "fhr:Completeness"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:masking",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "masking",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Masking applied to the genome assembly",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Text"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:metadataAuthor",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "metadataAuthor",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "Authors of the FHR instance",
        "@language": "en"
      },
      "sdo:domainIncludes": [
        {
          "@id": "sdo:Dataset"
        }
      ],
      "sdo:rangeIncludes": [
        {
          "@id": "sdo:Person"
        },
        {
          "@id": "sdo:Organization"
        },
        {
          "@id": "fhr:Agent"
        },
        {
          "@id": "fhr:MetadataAuthor"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://w3id.org/fair-bioheaders/terms"
      }
    },
    {
      "@id": "fhr:missing",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "missing",
